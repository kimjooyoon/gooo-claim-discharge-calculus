gooo claim_discharge_calculus v1

entity name=Claim id=gooo://claim-discharge/Claim edge=authority:entity:Claim
entity name=Evidence id=gooo://claim-discharge/Evidence edge=authority:entity:Evidence
entity name=DischargeRule id=gooo://claim-discharge/DischargeRule edge=authority:entity:DischargeRule
entity name=ActiveFrontierProjection id=gooo://claim-discharge/ActiveFrontierProjection edge=authority:entity:ActiveFrontierProjection

denominator id=claim-discharge-v1 cells=12
runtime repository_writes=0 local_test_executions=0 cross_project_required_gates=0
precedence values=REFUTED,UNKNOWN,CLOSED
unknown_fields values=stage,step,reason,unknown_class,next_operation,blocked_by
explicit_fixed_point value=FIXED_POINT
public_utility value=UNKNOWN

proof branch=FOUNDATION cells=4 edge=authority:proof:FOUNDATION
proof branch=COHERENCE cells=4 edge=authority:proof:COHERENCE
proof branch=REGRESSION cells=4 edge=authority:proof:REGRESSION

indicator class=DRIVER id=indicator:DRIVER:1 cells=1 edge=authority:indicator:DRIVER:1
indicator class=DRIVER id=indicator:DRIVER:2 cells=1 edge=authority:indicator:DRIVER:2
indicator class=DRIVER id=indicator:DRIVER:3 cells=1 edge=authority:indicator:DRIVER:3
indicator class=DRIVER id=indicator:DRIVER:4 cells=1 edge=authority:indicator:DRIVER:4
indicator class=OUTCOME id=indicator:OUTCOME:1 cells=1 edge=authority:indicator:OUTCOME:1
indicator class=OUTCOME id=indicator:OUTCOME:2 cells=1 edge=authority:indicator:OUTCOME:2
indicator class=OUTCOME id=indicator:OUTCOME:3 cells=1 edge=authority:indicator:OUTCOME:3
indicator class=OUTCOME id=indicator:OUTCOME:4 cells=1 edge=authority:indicator:OUTCOME:4
indicator class=GUARDRAIL id=indicator:GUARDRAIL:1 cells=1 edge=authority:indicator:GUARDRAIL:1
indicator class=GUARDRAIL id=indicator:GUARDRAIL:2 cells=1 edge=authority:indicator:GUARDRAIL:2
indicator class=GUARDRAIL id=indicator:GUARDRAIL:3 cells=1 edge=authority:indicator:GUARDRAIL:3
indicator class=GUARDRAIL id=indicator:GUARDRAIL:4 cells=1 edge=authority:indicator:GUARDRAIL:4

rule id=EXACT_PROOF_DISCHARGE edge=rule:exact-proof-discharge matches=subject,predicate,scope_digest,contract_digest,toolchain_digest evidence_state=SUPPORTS proof_branch=SELECTED frontier_action=REMOVE decision=CLOSED resolution=FIXED_POINT precedence=3
rule id=KNOWN_COUNTEREXAMPLE edge=rule:known-counterexample matches=subject,predicate,scope_digest,contract_digest,toolchain_digest evidence_state=REFUTES proof_branch=ANY frontier_action=RETAIN decision=REFUTED resolution=REFUTED precedence=1
rule id=UNKNOWN_FAIL_CLOSED edge=rule:unknown-fail-closed matches=subject,predicate,scope_digest,contract_digest,toolchain_digest evidence_state=UNKNOWN proof_branch=ANY frontier_action=RETAIN decision=UNKNOWN resolution=UNKNOWN precedence=2
rule id=OPERATIONAL_REFUTED edge=rule:operational-refuted matches=subject,predicate,scope_digest,contract_digest,toolchain_digest evidence_state=OPERATIONAL_REFUTED proof_branch=ANY frontier_action=RETAIN decision=REFUTED resolution=OPERATIONAL_REFUTED precedence=1

projection id=frontier:active edge=projection:claim->frontier initial_claim_ids=claim:closed-foundation,claim:closed-coherence,claim:closed-regression,claim:closed-foundation-repeat,claim:unknown-subject,claim:unknown-branch,claim:unknown-contract,claim:unknown-missing,claim:refuted-direct,claim:refuted-priority,claim:refuted-branch,claim:refuted-operational

activity ordinal=1 id=DECLARE_CLAIM edge=activity:declare->claim inputs=Claim output=Claim
activity ordinal=2 id=REGISTER_EVIDENCE edge=activity:evidence->ledger inputs=Evidence output=Evidence
activity ordinal=3 id=CONNECT_EVIDENCE edge=activity:evidence->claim inputs=Evidence,Claim output=Claim
activity ordinal=4 id=COMPARE_IDENTITY edge=activity:compare->tuple inputs=Claim,Evidence output=DischargeRule
activity ordinal=5 id=SELECT_PROOF_BRANCH edge=activity:select-proof->branch inputs=DischargeRule output=DischargeRule
activity ordinal=6 id=EVALUATE_DISCHARGE edge=activity:evaluate->decision inputs=Claim,Evidence,DischargeRule output=Claim
activity ordinal=7 id=PROJECT_FRONTIER edge=activity:project->frontier inputs=Claim output=ActiveFrontierProjection
activity ordinal=8 id=RETAIN_APPEND_ONLY edge=activity:retain->ledger inputs=Claim,Evidence output=Claim
activity ordinal=9 id=EMIT_CLOSED edge=activity:closed->frontier inputs=Claim,ActiveFrontierProjection output=ActiveFrontierProjection
activity ordinal=10 id=EMIT_UNKNOWN edge=activity:unknown->frontier inputs=Claim,ActiveFrontierProjection output=ActiveFrontierProjection
activity ordinal=11 id=EMIT_REFUTED edge=activity:refuted->frontier inputs=Claim,ActiveFrontierProjection output=ActiveFrontierProjection
activity ordinal=12 id=RECORD_OPERATIONAL_REFUTED edge=activity:operational-refuted->ledger inputs=Evidence,Claim output=Claim

